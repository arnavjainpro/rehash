# MongoDB Atlas connection string (Database Access user, e.g. arnavnyc_db_user)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# OpenRouter API key (quality path + embeddings: gpt-4o-mini, text-embedding-3-small)
OPENROUTER_API_KEY=sk-or-v1-...

# Fireworks API key (fast path for live speculation). Falls back to OpenRouter if unset.
FIREWORKS_API_KEY=

# ElevenLabs API key (Scribe STT + streaming TTS for the voice layer)
ELEVENLABS_API_KEY=sk_...

# LangSmith tracing (optional). Nested traces for speculate → embed → search → verdict.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=rehash
