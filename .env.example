# MongoDB Atlas connection string (Database Access user, e.g. arnavnyc_db_user)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# OpenRouter API key (serves both openai/gpt-4o-mini and openai/text-embedding-3-small)
OPENROUTER_API_KEY=sk-or-v1-...

# ElevenLabs API key (Scribe STT + streaming TTS for the voice layer)
ELEVENLABS_API_KEY=sk_...
